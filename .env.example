# Copy this file to .env.local and fill in values as they become available.
# .env.local (and any other .env* file except this one) is already listed in
# .gitignore, so real secrets never get committed to the repository.
#
# None of these are required for local development — the site works fully
# without them: it falls back to a localhost URL, the contact form runs in
# "demo mode" (submissions are validated and logged, not emailed), and
# analytics simply doesn't load.

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# The real production domain, once one exists. No trailing slash.
# Used for metadataBase, canonical URLs, Open Graph URLs, sitemap.xml, and
# robots.txt. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# Contact / project inquiry form — email (via Resend)
# ---------------------------------------------------------------------------
# The contact form emails inquiries using Resend (https://resend.com).
# Until both EMAIL_API_KEY and EMAIL_FROM are set, the form runs in "demo
# mode": submissions are validated and logged server-side, but no email is
# sent, and the visitor is told this honestly rather than a false success
# message. See src/app/api/contact/route.ts.
#
# Server-only — do NOT prefix these with NEXT_PUBLIC_, they must never be
# exposed to the browser.

# Your Resend API key. Create one at https://resend.com/api-keys after
# verifying a sending domain at https://resend.com/domains.
EMAIL_API_KEY=

# The verified sender address emails are sent FROM (must be on a domain
# you've verified in Resend). Supports the "Name <email>" format.
# Example: "Northlight Studio <notifications@yourdomain.com>"
EMAIL_FROM=

# The business inbox that should receive lead notifications. Falls back to
# `siteConfig.contact.email` (in src/lib/site-config.ts) if unset.
CONTACT_EMAIL=hello@northlightstudio.com

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX), from
# https://analytics.google.com under Admin > Data Streams > your web stream.
# Analytics only loads when this is set — leave blank in development.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Supabase — backend for the /admin dashboard (auth + database)
# ---------------------------------------------------------------------------
# See docs/supabase-setup.md for the full setup walkthrough, including how
# to run the migrations in supabase/migrations/ and create your first admin
# user. Without these three variables set, /admin/login cannot function —
# unlike the contact form above, there's no "demo mode" for auth, since
# this is an internal tool, not something a site visitor needs to work with
# zero configuration.
#
# All three come from your Supabase project dashboard: Settings > API Keys.

# PUBLIC — safe to expose in browser code. Your project's API URL.
NEXT_PUBLIC_SUPABASE_URL=

# PUBLIC — safe to expose in browser code. Replaces the older "anon key"
# naming; carries the same low privileges (subject to Row Level Security,
# cannot bypass it). Copy the "Publishable key" value from Settings > API
# Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY, SECRET — do NOT prefix with NEXT_PUBLIC_, and never import it
# into any file a Client Component could pull in. Replaces the older
# "service_role key" naming; bypasses Row Level Security entirely. Used by
# src/lib/supabase/admin.ts, which POST /api/contact calls to store contact
# form submissions (see supabase/migrations/20260804090000_create_contact_
# inquiry_function.sql) — this is the only code that uses it as of this
# phase. Copy the "Secret key" value from Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=
